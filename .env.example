# Base de Datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/unifind_db?schema=public"

# Auth.js v5 (usa AUTH_SECRET; NEXTAUTH_* se mantiene por compatibilidad)
AUTH_SECRET="tu_secret_super_seguro_aqui_generado_con_openssl"
NEXTAUTH_SECRET="tu_secret_super_seguro_aqui_generado_con_openssl"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Microsoft Entra ID / Azure AD (M365 Educación) — opcional.
# Sin estas tres, Credentials sigue funcionando y el botón Microsoft no aparece.
# No pongas credenciales reales en este archivo.
# AUTH_MICROSOFT_ENTRA_ID_ISSUER acepta URL completa o solo el tenant id.
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<Directory-tenant-id>/v2.0
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
# Dominios institucionales permitidos (coma-separados). Vacío = cualquier correo del tenant.
# AUTH_MICROSOFT_ALLOWED_DOMAIN=unilibre.edu.co
# Redirect URI en Entra (plataforma Web):
#   {AUTH_URL}/api/auth/callback/microsoft-entra-id

# Cloudinary (fotos privadas del panel de vigilancia)
# Tipo: authenticated (nunca upload público). Carpeta: unifind_private_items
# El catálogo público no recibe estas URLs. El admin las firma en el servidor.
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# Resend (envío de correos de reclamo)
RESEND_API_KEY="re_123456789_tu_api_key_resend"
EMAIL_FROM="UniFind <soporte@unifind.edu.co>"
ADMIN_NOTIFICATION_EMAIL="porteria.principal@unilibre.edu.co"

# Cron de retención (Bearer token)
CRON_SECRET="secret_token_para_ejecutar_cron_job"

# Identidad visual pública (solo assets institucionales; NUNCA fotos de objetos)
# Ruta en /public (ej. /brand/hero.jpg) o URL https pública. Vacío = placeholder del campus.
NEXT_PUBLIC_BRAND_HERO_URL=""
NEXT_PUBLIC_BRAND_LOGO_URL=""
NEXT_PUBLIC_BRAND_HOW_IT_WORKS_URL=""
NEXT_PUBLIC_BRAND_CATALOG_URL=""
NEXT_PUBLIC_BRAND_EMPTY_URL=""
NEXT_PUBLIC_BRAND_HERO_ALT="Campus Universidad Libre Barranquilla"
NEXT_PUBLIC_BRAND_LOGO_ALT="Universidad Libre"
